{
  "manifest_version": 3,
  "name": "Hush Tab Mixer",
  "version": "1.0.0",
  "description": "Set the volume of each browser tab, mute tabs, and jump to whatever is playing.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hush Tab Mixer",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
